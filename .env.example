# Where the contact form posts its payload.
# Leave unset in development: submissions are logged to the server console instead.
# Set to any endpoint that accepts a JSON POST (CRM webhook, Power Automate flow,
# Logic App, Formspree, Resend proxy, etc.).
AITRONIXUS_CONTACT_WEBHOOK=

# Optional: address shown as the destination in the server log line.
AITRONIXUS_CONTACT_INBOX=

# Absolute origin used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.aitronixus.com
